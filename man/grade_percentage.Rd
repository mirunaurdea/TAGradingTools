\title{
Grade Percentage
}
\description{
This function can be used to transform points into grade percentages.
}
\usage{
grade_percentage(points, total)
}
\arguments{
  \item{points}{
  The amount of points obtained by a student
}
  \item{total}{
  The total number of points that can be obtained
}
}
